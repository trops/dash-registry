{
    "name": "dash-registry",
    "version": "1.5.15",
    "private": true,
    "description": "Package registry and marketplace for Dash",
    "scripts": {
        "dev": "next dev --port 3001",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm run test && npm run build",
        "preversion": "npm run check",
        "create-project": "node scripts/create-project.js",
        "ci": "./scripts/ci.sh",
        "ci:commit": "./scripts/ci.sh --commit",
        "ci:push": "./scripts/ci.sh --push",
        "ci:pr": "./scripts/ci.sh --pr",
        "ci:release": "./scripts/ci.sh --release"
    },
    "dependencies": {
        "@aws-amplify/backend": "^1.21.0",
        "@aws-amplify/backend-cli": "^1.8.2",
        "@aws-amplify/ui-react": "^6.15.1",
        "@aws-sdk/client-cognito-identity-provider": "^3.1004.0",
        "@aws-sdk/client-dynamodb": "^3.1004.0",
        "@aws-sdk/client-s3": "^3.1004.0",
        "@aws-sdk/lib-dynamodb": "^3.1004.0",
        "@aws-sdk/s3-request-presigner": "^3.1004.0",
        "aws-amplify": "^6.16.2",
        "aws-jwt-verify": "^4.0.1",
        "fuse.js": "^7.0.0",
        "next": "^14.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "autoprefixer": "^10.4.0",
        "aws-cdk-lib": "^2.241.0",
        "constructs": "^10.5.1",
        "eslint": "^8.57.1",
        "eslint-config-next": "^14.2.35",
        "postcss": "^8.4.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.4.0",
        "vitest": "^4.1.4"
    }
}
